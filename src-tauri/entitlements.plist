<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for notarization.
  Spiel is intentionally NOT App-Sandboxed: it needs a global hotkey, Accessibility
  (to synthesize Cmd+V), and microphone access, which the sandbox would block.
  Only the microphone device entitlement is required here; Accessibility is granted by
  the user at runtime via TCC, not via an entitlement.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
